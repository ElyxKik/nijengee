# Supabase > Project URL. Serveur uniquement.
SUPABASE_URL=https://your-project.supabase.co
# Supabase > API Keys > Secret key. Ne jamais préfixer par NEXT_PUBLIC_ ni exposer au navigateur.
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Clé publishable : utilisée uniquement par le ping quotidien GitHub Actions.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Projet distinct obligatoire pour les tests destructifs (ne jamais réutiliser la base de production).
SUPABASE_TEST_MODE=false
SUPABASE_TEST_URL=
SUPABASE_TEST_SECRET_KEY=
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# En production, définir l’URL canonique HTTPS du site (ex. https://nijengee.cd).
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-long-password
SEED_DEMO=false
RESEND_API_KEY=
MAIL_FROM=Nijengee <notifications@example.com>
TRUST_PROXY=false
